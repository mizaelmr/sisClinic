VITE_APP_VERSION=$npm_package_version
VITE_APP_PORT=5005
VITE_BASENAME=/aurora-free
VITE_ASSET_BASE_URL=https://prium.github.io/aurora

# GOOGLE CALENDAR API CREDENTIALS
# Obtenha essas credenciais em: https://console.cloud.google.com/
# 
# 1. Acesse o Google Cloud Console
# 2. Crie ou selecione um projeto
# 3. Ative a Google Calendar API
# 4. Crie credenciais OAuth 2.0 e API Key
# 5. Copie os valores abaixo e substitua pelos seus valores reais
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI
VITE_GOOGLE_API_KEY=SUA_API_KEY_AQUI
